{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend",
      "type": "shell",
      "command": "uv",
      "args": ["run", "fastapi", "dev", "src/progress/api/main.py"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src",
          "PROGRESS_STATE_HOME": "${workspaceFolder}/data"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": false,
        "group": "dev-servers"
      },
      "problemMatcher": [],
      "isBackground": true,
      "icon": { "id": "server", "color": "terminal.ansiGreen" }
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev"],
      "options": {
        "cwd": "${workspaceFolder}/web",
        "env": {
          "CHOKIDAR_USEPOLLING": "true",
          "VITE_HMR_POLLING_INTERVAL": "1000"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": false,
        "group": "dev-servers"
      },
      "problemMatcher": [],
      "isBackground": true,
      "icon": { "id": "zap", "color": "terminal.ansiYellow" }
    },
    {
      "label": "Start All",
      "dependsOn": ["Start Backend", "Start Frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "icon": { "id": "rocket", "color": "terminal.ansiBlue" }
    }
  ]
}
