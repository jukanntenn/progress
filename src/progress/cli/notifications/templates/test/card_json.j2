{% from "_feishu_v2.j2" import card, footer_content %}
{% set ns = namespace(elements=[]) %}
{%- set ns.elements = ns.elements + [{"tag": "markdown", "content": _("This is a test notification from Progress."), "text_align": "center", "text_size": "normal"}] -%}
{%- set ns.elements = ns.elements + [{"tag": "markdown", "content": "<font color='grey'>" ~ _("Your notification channel is working correctly.") ~ "</font>", "text_align": "center", "text_size": "normal"}] -%}
{%- set ns.elements = ns.elements + [{"tag": "markdown", "content": footer_content(generated_at), "text_align": "center", "text_size": "notation"}] -%}
{% set text_tags = [{"tag": "text_tag", "text": {"tag": "plain_text", "content": "TEST"}, "color": "green"}] %}
{{ card(_("Test Notification"), ns.elements, "", "green", header_icon_token="check-circle-outlined", header_icon_color="green", text_tags=text_tags) }}
