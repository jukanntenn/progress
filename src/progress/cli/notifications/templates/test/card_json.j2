{% from "_feishu_v2.j2" import card %}
{% set ns = namespace(elements=[]) %}
{%- set ns.elements = ns.elements + [{"tag": "markdown", "content": "**✅  " ~ _("Notification channel configured correctly!") ~ "**", "text_align": "center", "text_size": "heading-2"}] -%}
{%- set ns.elements = ns.elements + [{"tag": "markdown", "content": "<font color='grey'>" ~ _("You have successfully received this test notification from Progress.<br>Your Feishu Webhook is working.") ~ "</font>", "text_align": "center", "text_size": "normal"}] -%}
{%- set ns.elements = ns.elements + [{"tag": "hr"}] -%}
{%- set ns.elements = ns.elements + [{"tag": "button", "text": {"tag": "plain_text", "content": " " ~ _("Go to Progress Settings")}, "type": "primary_filled", "width": "fill", "size": "medium", "behaviors": [{"type": "open_url", "default_url": "#"}]}] -%}
{%- set ns.elements = ns.elements + [{"tag": "hr"}] -%}
{%- set ns.elements = ns.elements + [{"tag": "markdown", "content": "<font color='grey'>⏱ " ~ _("Generated by Progress · Test message, no reply needed") ~ "</font>", "text_size": "notation"}] -%}
{% set text_tags = [{"tag": "text_tag", "text": {"tag": "plain_text", "content": "TEST"}, "color": "green"}] %}
{{ card(_("Test Notification"), ns.elements, "", "green", "", "check-circle-outlined", "green", text_tags) }}
