{% from "_email.j2" import email_shell, cta_button, hr %}
{% call email_shell(_("Test Notification"), "green", "TEST", "green", footer="⏱ " ~ _("Generated by Progress · Test message, no reply needed")) %}
<div style="text-align:center;padding:20px 0 8px 0;">
  <div style="font-size:22px;font-weight:700;color:#1D2129;margin-bottom:12px;">{{ _("✅ Test Notification from Progress") }}</div>
  <div style="font-size:14px;color:#86909C;line-height:1.6;">{{ _("This is a test notification. If you received this, the notification channel is configured correctly.") }}</div>
  <div style="font-size:12px;color:#86909C;margin-top:8px;">{{ _("Sent from Progress config console.") }}</div>
</div>
{{ cta_button("#", _("Go to Progress Settings"), "green") }}
{% endcall %}
