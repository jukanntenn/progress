{% macro footer(generation_time) %}
{% set _progress_link = "[Progress](https://github.com/jukanntenn/progress)" %}*⚙️ {{ _("Generated by %(progress)s · %(time)s") | format(progress=_progress_link, time=generation_time) }}*
{% endmacro %}

{% macro status_icon(status) -%}
{%- if status == "success" -%}
✅
{%- elif status == "failed" -%}
❌
{%- else -%}
➖
{%- endif -%}
{%- endmacro %}
