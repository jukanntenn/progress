{% from "report_base.j2" import footer, status_icon %}

{% set success_count = repo_statuses.values() | select('equalto', 'success') | list | length %}
{% set failed_count = repo_statuses.values() | select('equalto', 'failed') | list | length %}
{% set partial_count = repo_statuses.values() | select('equalto', 'partial') | list | length %}
{% set skipped_count = repo_statuses.values() | select('equalto', 'skipped') | list | length %}

{% if report_type != "repo_new" %}
<details>
<summary>✅ {{ success_count }}  ❌ {{ failed_count }}  ➖ {{ skipped_count + partial_count }} — {{ _("Repository details") }}</summary>

{% for repo_name, status in repo_statuses.items() %}- {{ status_icon(status) }} {{ repo_name }}
{% endfor %}
</details>
{% endif %}

{% for content in rendered_reports %}{{ content }}

{% if not loop.last %}---

{% endif %}{% endfor %}
{% if total_batches > 1 and batch_index < total_batches - 1 %}

_*{{ _("More reports will follow in the next batch...") }}*_

{% endif %}
{{ footer(generation_time) }}
