{% from "report_base.j2" import footer %}

{% for kind, items in grouped_events.items() %}
{% set tracker_url = tracker_urls.get(kind) %}
{% if tracker_url %}
## [{{ kind | upper }}]({{ tracker_url }})
{% else %}
## {{ kind | upper }}
{% endif %}

{% for e in items %}
{% set file_name = e.file_path | basename %}
{% if e.title and e.file_url %}
### [{{ e.title }}]({{ e.file_url }})
{% elif e.title %}
### {{ e.title }}
{% elif e.file_url %}
### [#{{ e.number }} {{ file_name }}]({{ e.file_url }})
{% else %}
### #{{ e.number }} {{ file_name }}
{% endif %}
<small>#️⃣ #{{ e.number }} · 📌 {% if e.old_status %}{{ e.old_status.value }} → {{ e.new_status.value }}{% else %}{{ e.new_status.value }} ({{ _("new") }}){% endif %} · 📄 {{ file_name }}</small>

{{ e.analysis_summary or _("No summary available.") }}

<details>
<summary>{{ _("Click to view detailed analysis") }}</summary>

{{ e.analysis_detail or _("No detailed analysis available.") }}

</details>

