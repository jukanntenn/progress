{% from "_email.j2" import email_shell, badge, cta_button, hr, section_heading %}
{% set proposals = proposals or [] %}
{% call email_shell(title, "blue", "NEW " ~ (proposals | length), "blue") %}
{{ section_heading("📄 " ~ _("Proposal List") ~ " (" ~ (proposals | length) ~ ")") }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;font-size:13px;margin:4px 0;table-layout:fixed;">
  <thead><tr>
    <th align="left" style="background-color:#F7F8FA;color:#86909C;font-weight:600;padding:10px 12px;border-radius:6px 0 0 6px;width:60%;">{{ _("Proposal") }}</th>
    <th align="left" style="background-color:#F7F8FA;color:#86909C;font-weight:600;padding:10px 12px;width:15%;">{{ _("Type") }}</th>
    <th align="left" style="background-color:#F7F8FA;color:#86909C;font-weight:600;padding:10px 12px;border-radius:0 6px 6px 0;width:25%;">{{ _("Status") }}</th>
  </tr></thead>
  <tbody>
  {% for p in proposals %}
  {%- set status_text = (p.old_status ~ " → " ~ p.new_status) if p.old_status else (p.new_status ~ " (" ~ _("new") ~ ")") -%}
  {%- set sc = status_color("proposal_status", p.new_status) -%}
  {%- set kc = status_color("proposal_kind", p.kind) -%}
  <tr>
    <td valign="middle" style="padding:10px 12px;border-bottom:1px solid #F2F3F5;color:#1D2129;word-break:break-word;">
      {%- if p.file_url -%}<a href="{{ p.file_url }}" style="color:#3370FF;text-decoration:none;">#{{ p.number }} {{ p.title or p.file_name }}</a>{%- else -%}#{{ p.number }} {{ p.title or p.file_name }}{%- endif -%}
    </td>
    <td valign="middle" style="padding:10px 12px;border-bottom:1px solid #F2F3F5;">{{ badge(p.kind, kc) }}</td>
    <td valign="middle" style="padding:10px 12px;border-bottom:1px solid #F2F3F5;word-break:break-word;">{{ badge(status_text, sc) }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% if markpost_url %}
{{ cta_button(markpost_url, _("View Proposal Details") ~ "（Markpost）", "blue") }}
{% endif %}
{% endcall %}
