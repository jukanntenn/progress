{% from "_feishu_v2.j2" import card %}
{% set proposals = proposals or [] %}
{% set visible = proposals[:5] %}
{% set rest = proposals[5:] %}
{% set ns = namespace(elements=[]) %}
{%- set ns.elements = ns.elements + [{"tag": "markdown", "content": "📄 **" ~ _("Proposal List") ~ "**", "text_size": "heading-4"}] -%}
{% set rows_ns = namespace(rows=[]) %}
{% for p in visible %}
{%- set status_text = (p.old_status ~ " → " ~ p.new_status) if p.old_status else (p.new_status ~ " (" ~ _("new") ~ ")") -%}
{%- set sc = status_color("proposal_status", p.new_status) -%}
{%- set kc = status_color("proposal_kind", p.kind) -%}
{%- set title_md = "[#" ~ p.number ~ " " ~ (p.title or p.file_name) ~ "](" ~ p.file_url ~ ")" if p.file_url else ("#" ~ p.number ~ " " ~ (p.title or p.file_name)) -%}
{%- set rows_ns.rows = rows_ns.rows + [{
  "proposal": title_md,
  "kind": {"text": p.kind, "color": kc},
  "status": {"text": status_text, "color": sc}
}] -%}
{% endfor %}
{%- set ns.elements = ns.elements + [{
  "tag": "table", "page_size": 5, "row_height": "low",
  "header_style": {"text_align": "left", "text_size": "normal", "background_style": "grey-50", "text_color": "grey", "bold": True},
  "columns": [
    {"name": "proposal", "display_name": _("Proposal"), "data_type": "lark_md", "width": "55%"},
    {"name": "kind", "display_name": _("Type"), "data_type": "options", "width": "15%"},
    {"name": "status", "display_name": _("Status"), "data_type": "options", "width": "30%"}
  ],
  "rows": rows_ns.rows
}] -%}
{% if rest %}
{%- set rest_lines = namespace(items=[]) -%}
{% for p in rest %}{% set rest_lines.items = rest_lines.items + ["- #" ~ p.number ~ " " ~ (p.title or p.file_name)] %}{% endfor %}
{%- set ns.elements = ns.elements + [{"tag": "collapsible_panel", "background_color": "grey-50", "border": {"color": "grey-200", "corner_radius": "6px"}, "header": {"title": {"tag": "markdown", "content": "▸ " ~ _("Expand remaining") ~ " " ~ (rest | length) ~ " " ~ _("proposals")}, "background_color": "grey-50"}, "elements": [{"tag": "markdown", "content": rest_lines.items | join("\n")}]}] -%}
{% endif %}
{%- set ns.elements = ns.elements + [{"tag": "hr"}] -%}
{% if markpost_url %}
{%- set ns.elements = ns.elements + [{"tag": "button", "text": {"tag": "plain_text", "content": " " ~ _("View Proposal Details") ~ "（Markpost）"}, "type": "primary_filled", "width": "fill", "size": "medium", "behaviors": [{"type": "open_url", "default_url": markpost_url}]}] -%}
{%- set ns.elements = ns.elements + [{"tag": "hr"}] -%}
{% endif %}
{%- set ns.elements = ns.elements + [{"tag": "markdown", "content": "<font color='grey'>⏱ " ~ _("Generated by Progress") ~ "</font>", "text_size": "notation"}] -%}
{% set text_tags = [{"tag": "text_tag", "text": {"tag": "plain_text", "content": "NEW " ~ (proposals | length)}, "color": "blue"}] %}
{{ card(title, ns.elements, markpost_url, "blue", "", "doc-outlined", "blue", text_tags) }}
