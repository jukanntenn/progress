{% from "_email.j2" import email_shell, cta_button %}
{% set feeds = feeds or [] %}
{% set total = (feeds | map(attribute="entry_count") | sum) or (entry_count | default(0)) %}
{% call email_shell(title, "wathet", total ~ " " ~ _("new"), "wathet", generated_at=generated_at) %}
{% if summary %}<div style="background-color:#E8F3FF;border-radius:8px;padding:14px 16px;margin-bottom:8px;font-size:14px;line-height:1.6;color:#1D2129;">{{ summary }}</div>{% endif %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate;border-spacing:6px;margin:8px 0;">
  {% for batch in feeds | batch(2) %}
  <tr>
  {% for f in batch %}
  <td width="{{ (100 // (batch | length)) }}%" valign="top" style="background-color:#E8F3FF;border-radius:8px;padding:16px 10px;text-align:center;">
    <div style="font-size:13px;color:#1D2129;font-weight:600;margin-bottom:8px;">{{ f.title }}</div>
    <div style="font-size:30px;font-weight:700;color:#0091FF;line-height:1;">{{ f.entry_count }}</div>
    <div style="font-size:12px;color:#86909C;margin-top:6px;">{{ _("new articles") }}</div>
  </td>
  {% endfor %}
  </tr>
  {% endfor %}
</table>
{% if total_batches is defined and total_batches > 1 %}
<div style="font-size:12px;color:#86909C;margin-top:4px;">{{ _("Part {n} of {total}").format(n=batch_index + 1, total=total_batches) }}</div>
{% endif %}
{% if markpost_url %}
{{ cta_button(markpost_url, _("View Report"), "wathet") }}
{% endif %}
{% endcall %}
