{# v2ex email HTML (spec v2ex §10).

Reuses the shared ``email_shell`` frame + ``cta_button``. Body: AI summary +
per-tab grouped post cards (linked title + badge row + takeaway). All styles
are inline / table-based for email-client compatibility (see ``_email.j2``).
External data (title/url/author) escaped; AI takeaway rendered verbatim.
#}
{% from "_email.j2" import email_shell, cta_button %}
{% set groups = groups or [] %}
{% call email_shell(title, "wathet", selected_count ~ " " ~ _("picks"), "wathet", generated_at=generated_at) %}
{% if summary %}<div style="background-color:#E8F3FF;border-radius:8px;padding:14px 16px;margin-bottom:8px;font-size:14px;line-height:1.6;color:#1D2129;">{{ summary }}</div>{% endif %}
{% for group in groups %}
<div style="font-size:15px;font-weight:700;color:#1D2129;margin:14px 0 8px 0;">{{ group.icon }} {{ group.tab_title }}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate;border-spacing:6px;margin:4px 0;">
  {% for p in group.posts %}
  <tr>
    <td valign="top" style="background-color:#F7F8FA;border-radius:8px;padding:12px 14px;font-size:14px;color:#1D2129;">
      <a href="{{ p.url }}" style="color:#0091FF;text-decoration:none;font-weight:600;word-break:break-all;">{{ p.title }}</a>
      <span style="display:inline-block;margin-left:6px;padding:2px 8px;border-radius:9px;background-color:#E8F3FF;color:#0091FF;font-size:11px;font-weight:600;">⭐ {{ p.score }}</span>
      <div style="margin-top:6px;font-size:13px;color:#4E5969;line-height:1.5;">{{ p.takeaway }}</div>
    </td>
  </tr>
  {% endfor %}
</table>
{% endfor %}
{% if total_batches is defined and total_batches > 1 %}
<div style="font-size:12px;color:#86909C;margin-top:4px;">{{ _("Part {n} of {total}").format(n=batch_index + 1, total=total_batches) }}</div>
{% endif %}
{% if markpost_url %}
{{ cta_button(markpost_url, _("View Report"), "wathet") }}
{% endif %}
{% endcall %}
