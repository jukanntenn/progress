{% from "_email.j2" import email_shell, badge, cta_button, section_heading %}
{% set entries = entries or [] %}
{% call email_shell(title, "indigo", "RELEASE " ~ (entries | length), "indigo", generated_at=generated_at) %}
{{ section_heading("📦 " ~ _("Version List") ~ " (" ~ (entries | length) ~ ")") }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate;border-spacing:0 6px;margin:0 0 4px 0;">
  {% for e in entries %}
  {% set lc = status_color("changelog_level", e.level) if e.level else "" %}
  <tr>
    <td valign="middle" style="background-color:#F7F8FA;border-radius:8px;padding:10px 12px;font-size:14px;color:#1D2129;word-break:break-word;">
      <strong>{{ e.name }}</strong>　<code style="background-color:#F2F3F5;padding:1px 6px;border-radius:3px;font-size:12px;color:#4E5969;">{{ e.version }}</code>
      {%- if e.level %}　{{ badge(e.level ~ " ⬆", lc) }}{% endif -%}
      {%- if e.url %}　<a href="{{ e.url }}" style="color:#3370FF;text-decoration:none;font-size:13px;font-weight:600;white-space:nowrap;">{{ _("Release Note") }} →</a>{%- endif -%}
    </td>
  </tr>
  {% endfor %}
</table>
{% if markpost_url %}
{{ cta_button(markpost_url, _("View Report"), "indigo") }}
{% endif %}
{% endcall %}
