# Progress Ansible-class configuration (spec 02).
#
# This file carries ONLY ``state_home`` — the root directory for all runtime
# data (DB, logs, cloned repos, observability exports). All user-facing
# settings (language, credentials, repos, notification channels, etc.) live in
# the DB ``config`` table and are managed via the Web UI or seeded via the
# one-time ``config.db.toml`` seed file.
#
# It is rendered by Ansible and mounted read-only into the container at
# /app/config.toml. Env-var overrides (prefix ``PROGRESS_``, separator ``__``)
# still apply on top.

state_home = "/app/data"
