services:
  progress:
    image: 192.168.5.50:5000/progress:next
    container_name: progress
    ports:
      - "5053:5000"
    volumes:
      - ./config.toml:/app/config.toml:ro
      - ./data:/app/data
    environment:
      - TZ=Asia/Shanghai
      - PYTHONUNBUFFERED=1
      - PROGRESS_SCHEDULE_CRON=30 8,22 * * *
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:5000/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 45s
    restart: always
