services:
  progress:
    image: {{ registry_url }}/{{ image_name }}:{{ image_tag }}
    container_name: progress
    ports:
      - "{{ host_port }}:5000"
    volumes:
      - ./config.toml:/app/config.toml:ro
      - ./data:/app/data
    environment:
      - TZ=Asia/Shanghai
      - PYTHONUNBUFFERED=1
      - PROGRESS_SCHEDULE_CRON={{ cron }}
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:5000/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 45s
    restart: always
