#!/bin/sh
# supercronic longrun service (spec 05 / spec 14).
#
# Reads PROGRESS_SCHEDULE_CRON and runs ``progress run`` on that schedule.
# When the var is empty/unset the service idles (sleep infinity) so the s6
# bundle stays healthy without firing any job.
#
# Runs as the non-root ``progress`` user (Dockerfile USER directive).

export CONFIG_FILE="${CONFIG_FILE:-/app/config.toml}"
export PYTHONPATH=/app/src
export PYTHONUNBUFFERED=1
export PATH="/usr/local/bin:${PATH}"

if [ -z "${PROGRESS_SCHEDULE_CRON}" ]; then
    echo "[cron] PROGRESS_SCHEDULE_CRON empty; idling"
    exec sleep infinity
fi

mkdir -p /tmp/supercronic
cat > /tmp/supercronic/crontab << EOF
${PROGRESS_SCHEDULE_CRON} cd /app && /usr/local/bin/progress run -c "${CONFIG_FILE}"
EOF

supercronic -test /tmp/supercronic/crontab
exec supercronic -passthrough-logs /tmp/supercronic/crontab
